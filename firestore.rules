rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(wsId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid));
    }

    function isOwner(wsId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)).data.role == "owner";
    }

    function isAdmin(wsId) {
      let d = get(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)).data;
      return request.auth != null && (d.role == "owner" || d.role == "admin");
    }

    function isTeam(wsId) {
      let p = get(/databases/$(database)/documents/workspaces/$(wsId)).data.plan;
      return p == "empresa" || p == "pro";
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Workspaces ───────────────────────────────────────────────────────────
    match /workspaces/{wsId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid))
      );
      allow delete: if isOwner(wsId);

      // Members
      match /members/{memberId} {
        allow read: if isMember(wsId) || (request.auth != null && request.auth.uid == memberId);
        allow write: if isOwner(wsId)
          || (request.auth != null
              && request.auth.uid == memberId
              && get(/databases/$(database)/documents/workspaces/$(wsId)).data.ownerId == request.auth.uid
              && request.resource.data.role == "owner");
      }

      // Proyectos
      match /proyectos/{proyId} {
        allow read, write: if isMember(wsId);
        allow read: if true;
        allow create: if request.auth == null
          && request.resource.data.fromWizard == true
          && request.resource.data.createdBy == "wizard_publico";

        match /vistas/{vistaId} {
          allow read: if isMember(wsId);
          allow create: if true;
        }
        match /renders/{renderId} {
          allow read: if true;
          allow write: if isMember(wsId);
        }
        match /snapshots/{snapId} {
          allow read, write: if isMember(wsId);
        }
        match /tasks/{taskId} {
          allow read, write: if isMember(wsId);
        }
        match /comentarios/{commentId} {
          allow read: if isMember(wsId);
          allow create: if isMember(wsId)
            || (request.auth == null
                && request.resource.data.tipo == "cliente"
                && request.resource.data.autorUid == "cliente");
          allow delete: if isAdmin(wsId);
        }
        match /fotos/{fotoId} {
          allow read: if true;
          allow write: if isMember(wsId);
        }
      }

      // Clientes CRM
      match /clientes/{clienteId} {
        allow read, write: if isMember(wsId);
      }

      // Listino
      match /listino/{itemId} {
        allow read, write: if isMember(wsId);
      }

      // Categorie
      match /cats/{catId} {
        allow read, write: if isMember(wsId);
      }

      // Log attività — Admin SDK scrive, solo admin legge
      match /log_actividad/{logId} {
        allow read: if isAdmin(wsId);
        allow write: if false;
      }

      // Notifiche
      match /notifiche/{notifId} {
        allow read: if isMember(wsId);
        allow update: if isMember(wsId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow create: if request.auth == null
          && request.resource.data.source == "cliente";
      }

      // Firme
      match /firme/{firmaId} {
        allow read, create, update: if true;
        allow delete: if isOwner(wsId);
      }

      // Empleados
      match /empleados/{empId} {
        allow read, write: if isMember(wsId) && isTeam(wsId);
      }

      // Kits
      match /kits/{kitId} {
        allow read, write: if isMember(wsId);
      }

      // Bodega
      match /magazzino/{itemId} {
        allow read, write: if isMember(wsId);
      }
      match /movimenti/{movId} {
        allow read, write: if isMember(wsId);
      }

      // Solicitudes de material
      match /solicitudes/{solId} {
        allow read: if isMember(wsId);
        allow create: if isMember(wsId);
        allow update: if isAdmin(wsId);
        allow delete: if isAdmin(wsId);
      }

      // Fatture
      match /fatture/{fattId} {
        allow read, write: if isMember(wsId);
      }

      // Render Usage — Admin SDK scrive, membri leggono (per mostrare quota)
      match /renderUsage/{monthKey} {
        allow read: if isMember(wsId);
        allow write: if false;
      }

      // Nova Usage — contatore messaggi Nova mensili
      // Admin SDK scrive (incrementa), membri leggono (per mostrare quota usata)
      match /novaUsage/{monthKey} {
        allow read: if isMember(wsId);
        allow write: if false;
      }

      // Prompt Presets (TabDiseno)
      match /promptPresets/{presetId} {
        allow read, write: if isMember(wsId);
      }

      // Fotos workspace-level (legacy)
      match /fotos/{fotoId} {
        allow read, write: if isMember(wsId);
      }

      // Templates
      match /templates/{tplId} {
        allow read, write: if isMember(wsId);
      }

      // FCM Tokens
      match /fcmTokens/{token} {
        allow read: if isAdmin(wsId);
        allow write: if isMember(wsId);
        allow delete: if isMember(wsId);
      }

      // Nova Profile — profilo costruttore per personalizzazione AI
      match /novaProfile/{docId} {
        allow read: if isMember(wsId);
        allow write: if isMember(wsId);
      }

      // AI Usage — Admin SDK scrive, solo admin legge
      match /aiUsage/{docId} {
        allow read: if isAdmin(wsId);
        allow write: if false;
      }
    }

    // ── Benchmarks AI — dati di mercato aggregati (anonimizzati) ──────────
    // Lettura: qualsiasi utente autenticato (dati anonimizzati)
    // Scrittura: solo Admin SDK (Cloud Functions)
    match /benchmarks/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Inviti ───────────────────────────────────────────────────────────────
    match /invites/{inviteId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // ── Sistema ──────────────────────────────────────────────────────────────
    match /_sistema/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
